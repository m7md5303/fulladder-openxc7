set_property LOC B9 [get_ports {a}]
set_property IOSTANDARD LVCMOS33 [get_ports {a}]

set_property LOC B10 [get_ports {b}]
set_property IOSTANDARD LVCMOS33 [get_ports {b}]

set_property LOC B11 [get_ports {c}]
set_property IOSTANDARD LVCMOS33 [get_ports {c}]

set_property LOC B12 [get_ports {sum}]
set_property IOSTANDARD LVCMOS33 [get_ports {sum}]

set_property LOC A10 [get_ports {carry}]
set_property IOSTANDARD LVCMOS33 [get_ports {carry}]

